# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=Karnataka Crime Analytics Platform
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# POSTGRES_USER/PASSWORD is the table-owning superuser — used only for startup
# DDL (init_db). The running API never queries as this role: a superuser/table
# owner bypasses Postgres Row-Level Security entirely, which would make the
# district-isolation RLS policies silent no-ops.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=karnataka_crime

# Restricted, non-owner role the API actually connects as — RLS applies to this
# role. init_db() creates it automatically on first startup if it doesn't exist.
# Required — there is no hardcoded fallback for this one (see config.py).
POSTGRES_APP_USER=app_runtime
POSTGRES_APP_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Set only when deployed on Cloud Run with a Cloud SQL instance attached via
# `--add-cloudsql-instances` — switches DATABASE_URL/_ADMIN/_SYNC to the Unix
# socket DSN Cloud Run's Cloud SQL Auth Proxy sidecar exposes, instead of
# POSTGRES_HOST:POSTGRES_PORT. Leave blank for local Docker Compose.
INSTANCE_CONNECTION_NAME=

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
# Aura free-tier instances can name their database after the instance id
# instead of "neo4j" — check the credentials file Aura gave you (NEO4J_DATABASE
# line) and set this to match, or every query silently targets the wrong DB.
NEO4J_DATABASE=neo4j

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Vertex AI — Gemini (chat/tool-calling) + Gemini Live (voice) ──────────────
# Required for /chat, /chat/voice, /chat/voice/live, and /cases/{id}/brief
# (and native Kannada/English audio) to work. Auth is Application Default
# Credentials — point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON
# key with Vertex AI User (roles/aiplatform.user) on the target project.
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json

GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-preview-04-09

# ── Embeddings — local model, no API key needed ───────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Simulated MFA — see app/services/mfa_service.py ───────────────────────────
# Must be False whenever ENVIRONMENT=production (main.py refuses to start
# otherwise) — True hands OTP codes back in the API response, which is only
# acceptable until a real SMS/email provider is wired in.
ALLOW_MOCK_MFA=true
OTP_EXPIRE_MINUTES=5

# ── Demo seed data (scripts/seed_demo_data.py) ─────────────────────────────────
# Not read by the API itself — only by the seed script. Change these before
# running it anywhere the login list might be guessable/public; the script
# falls back to the values below only if these are unset.
SEED_DEMO_PASSWORD=Demo@12345
SEED_ADMIN_EMAIL=admin@ksp.demo
SEED_ADMIN_PASSWORD=Demo@12345

# ── File storage ──────────────────────────────────────────────────────────────
# /uploads is the named Docker volume (see backend/docker-compose.yml).
# Using /tmp/uploads here would make uploaded files ephemeral — lost on
# container restart. Override to an absolute local path for local dev outside Docker.
UPLOAD_DIR=/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Internal task triggers (Cloud Scheduler replacing Celery Beat on Cloud Run) ─
# Checked against the X-Internal-Task-Secret header on /api/v1/internal/tasks/*.
# Required — main.py refuses to start with this default value when
# ENVIRONMENT=production.
INTERNAL_TASK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
