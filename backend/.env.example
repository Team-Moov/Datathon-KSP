# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=Karnataka Crime Analytics Platform
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=karnataka_crime

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Google Cloud / Vertex AI ──────────────────────────────────────────────────
# Your GCP project ID (required)
GCP_PROJECT=your-gcp-project-id

# Vertex AI region — us-central1 has the widest Gemini model availability
GCP_LOCATION=us-central1

# Path to a Service Account JSON key for local development.
# On GCP (Cloud Run, GKE, Compute Engine) leave this EMPTY — Workload Identity
# / instance metadata provides credentials automatically via ADC.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Gemini model identifiers (Vertex AI) — change only to pin a specific version
LLM_MODEL=gemini-1.5-pro-002
LLM_MODEL_FLASH=gemini-1.5-flash-002
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
