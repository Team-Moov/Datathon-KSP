# Never let the build context (or COPY . .) pull secrets into an image layer.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
sa-key*.json
*service_account*.json
*service-account*.json

# VCS / editor / OS noise
.git
.gitignore
.idea
.vscode
*.swp
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
venv/
.venv/

# Alembic autogenerate artifacts a fresh image doesn't need
alembic/versions/*.pyc

# Local scratch
/tmp/
uploads/
*.log
