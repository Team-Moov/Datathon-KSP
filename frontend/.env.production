# Committed on purpose — see the !.env.production exception in .gitignore.
# This holds no secret: it is the backend's public origin, and production
# builds are broken without it. Catalyst Web Client Hosting serves static
# files with no server-side proxy, so a build missing this value sends every
# /api/v1 call to the Catalyst domain, which answers INVALID_URL_PATTERN and
# makes sign-in fail.
#
# No trailing slash — httpClient.ts appends "/api/v1".
VITE_API_BASE_URL=https://karnataka-crime-api-696328238223.us-central1.run.app
