venv.bak/

# ── Secrets & credentials — NEVER commit these ────────────────────────────────
backend/keys/
*.json.key
sa-key*.json
*service_account*.json

# ── Environment files ─────────────────────────────────────────────────────────
# .env.example IS committed (safe template); .env is NOT
backend/.env

# ── Alembic ───────────────────────────────────────────────────────────────────
backend/alembic/versions/

# ── Uploads / tmp ─────────────────────────────────────────────────────────────
uploads/
/tmp/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Celery ────────────────────────────────────────────────────────────────────
# celerybeat-schedule is a binary runtime artifact generated by Celery Beat
# automatically — committing it causes meaningless binary diffs and merge
# conflicts whenever the beat schedule changes between runs.
celerybeat-schedule
celerybeat.pid
backend/ml_source.db
